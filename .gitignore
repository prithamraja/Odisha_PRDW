# Secrets — never commit live keys
.env

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Embedding/index caches (rebuilt automatically)
.tmp/

# Discover build output — Parquet views, regenerated by build_views.py from
# Data/ + the domain pack. The validation and profile reports under
# Insights/reports_prdw/ ARE committed; only the binaries are ignored.
Insights/views_prdw/
views_prdw/

# Office lock files
~$*


# WP-4 eval artefacts: regenerated by the harnesses, large, and meaningless
# without the run that produced them. The REPORT carries the numbers.
# The backend directory was Chatbot/ through WP-4c and is Ask/ since the tree
# was reorganised on 2026-08-18. Both spellings are listed: a rename that
# quietly un-ignores 200 MB of replay artefacts is the kind of thing that is
# noticed at `git add`, which is too late.
Ask/eval_full_results*.jsonl
Ask/eval_full_graded*.json
Ask/consistency_results.jsonl
Ask/consistency_table.csv
Chatbot/eval_full_results*.jsonl
Chatbot/eval_full_graded*.json
Chatbot/consistency_results.jsonl
Chatbot/consistency_table.csv
consistency_run.log
