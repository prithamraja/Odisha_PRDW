ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
HF_TOKEN=hf_...
SARVAM_API_KEY=...

# ── Backend selection (DB_ENGINE) ────────────────────────────────────────────
# pandas (default, unset = this) | duckdb_file | supabase

# Flat AP datasets the PandasAdapter loads (<table>.parquet per db_factory.TABLES).
# Defaults to the shipped 10-row stub; repoint at the real drop to cut over.
DATA_DIR=./stub_data
# DATA_DIR=../../RTGS_Data/flat

# Odisha PR&DW analytical DB — a .duckdb file opened READ-ONLY.
# DB_PATH is relative to Chatbot/, like DATA_DIR. The file is attached read-only
# and the router's cache tables live in an in-memory catalog alongside it, so
# nothing is ever written to the Drive-synced database file.
# DB_ENGINE=duckdb_file
# DB_PATH=data/panchayat_1.duckdb

# Postgres
DB_ENGINE=supabase
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5433/ab_db

# Ngrok integration
NGROK_ENABLED=true