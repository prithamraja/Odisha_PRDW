# DiscoverChat reads Insights/.env for keys; nothing is duplicated here.
# These are the OVERRIDES, all optional, all with working defaults in config.py.

# --- keys (live in Insights/.env, never here) -------------------------------
# NOVITA_API_KEY=   embeddings (Qwen3), from Insights/.env
# OPENAI_API_KEY=   writer / verifier / classifier, from Insights/.env

# --- the embedding pin (must match the built corpus, or startup fails loud) --
# DISCOVER_EMBED_MODEL=qwen/qwen3-embedding-8b
# DISCOVER_EMBED_DIMS=1024
# DISCOVER_EMBED_BASE_URL=https://api.novita.ai/openai

# --- models ------------------------------------------------------------------
# DISCOVER_PROSE_MODEL=          the writer; D17's pin, via discover_config
# DISCOVERCHAT_VERIFIER_MODEL=gpt-5.5
# DISCOVERCHAT_VERIFIER_TOKENS=9000
# DISCOVERCHAT_CLASSIFIER_MODEL=gpt-5.5

# --- retrieval knobs: PROVISIONAL until the D5.3 operator gate ratifies them --
# DISCOVERCHAT_THRESHOLD=0.62
# DISCOVERCHAT_QUALITY_FLOOR=0.0
# DISCOVERCHAT_GEO_BOOST=0.06
# DISCOVERCHAT_MEASURE_BOOST=0.03
# DISCOVERCHAT_GEO_SUBSPACE_BONUS=0.02
# DISCOVERCHAT_FULL_RENDER_MAX=0
# DISCOVERCHAT_ANSWER_CAP=12
