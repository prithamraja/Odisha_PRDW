# Railway service variables — reference only. Set these in the Railway
# dashboard or with deploy/railway-deploy.sh. Do NOT commit real values;
# this file exists so nobody has to guess what the services need.

# ── Service: ask-api  (Root Directory: Ask) ─────────────────────────────────

# Required. Without it the backend still boots, but /query is disabled
# (see Ask/main.py:179) and the vector retriever cannot build.
OPENAI_API_KEY=sk-...

# Required. The default engine is "pandas", which reads Ask/stub_data/ — a
# directory that does not exist in this repo, so the container would crash on
# boot. duckdb_file reads the 24 MB database committed alongside the code.
DB_ENGINE=duckdb_file
DB_PATH=data/panchayat_1.duckdb

# Keep the ngrok tunnel off in production — it only exists for local demos.
NGROK_ENABLED=false

# Unbuffered stdout, so Railway's log view shows startup progress live rather
# than in one lump when the buffer flushes.
PYTHONUNBUFFERED=1

# PORT is injected by Railway. Do not set it; railway.json's start command
# already binds uvicorn to it.

# ── Service: ask-web  (Root Directory: frontend/ab-dashboard-main) ──────────

# Required, and BUILD-time: Vite inlines VITE_* into the bundle at build, so
# this must be set before the frontend builds, and changing it forces a
# rebuild. If it is missing, src/services/api.ts falls back to
# http://localhost:8000 — the deployed site loads fine and every question
# fails, which is the confusing failure mode, not an obvious one.
# No trailing slash.
VITE_API_BASE_URL=https://ask-api-production.up.railway.app
