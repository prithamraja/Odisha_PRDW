# Base URL of the Odisha PR&DW Decision Aid backend (Chatbot/backend).
# Local: start the backend with DB_PATH pointing at the PR&DW DuckDB file, then
#   python -m uvicorn main:app --host 127.0.0.1 --port 8000
# Deployed: set this to the backend's public URL in the Railway service vars.
VITE_API_BASE_URL=http://localhost:8000

# Base URL of DiscoverChat (DiscoverChat/main.py) — the findings-retrieval
# service behind the Discover tab's question box. A SEPARATE backend from Ask,
# on its own port; do not point both vars at the same URL.
# Local: python -m uvicorn DiscoverChat.main:app --host 127.0.0.1 --port 8100
VITE_DISCOVER_API_BASE_URL=http://localhost:8100
